# /etc/writer/writer.env  (chmod 600, owner writer)
# 所有字段对应 server/app/config.py，字段名大写即可。

DB_PATH=/var/lib/writer/writer.db

# 必须改成长随机串，例如: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# 个人应用建议注册完成后关闭
ALLOW_REGISTRATION=true

TOKEN_TTL_DAYS=30
RENEW_THRESHOLD_DAYS=7

# JSON 数组。不要用 *。
# 后面四个源分别是 Windows 桌面端和安卓安装包，必须保留，否则登录请求会被
# 浏览器内核按 CORS 拦掉（安装包没有同源后端）。
# 如果网页端和 API 由同一个 nginx 同域提供，网页端不需要额外加域名；
# 只有网页端跨域访问 API（比如本地 dev 的 http://localhost:5173）才需要把
# 对应来源加进来。注意：一旦设置这个变量，会整体覆盖代码里的默认列表。
# 整行用单引号包住：systemd 的 EnvironmentFile 会把未加引号的空格当作分隔符。
CORS_ORIGINS='["app://writer","http://localhost","https://localhost","capacitor://localhost"]'
